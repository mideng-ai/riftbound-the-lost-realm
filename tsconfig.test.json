{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "verbatimModuleSyntax": false,
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": true,
    "noEmit": false,
    "rootDir": "src",
    "outDir": ".testbuild"
  },
  "include": ["src/input", "src/domain", "src/config", "src/player", "src/weapons", "src/combat", "src/progression", "src/gems", "src/economy", "src/boss"]
}
